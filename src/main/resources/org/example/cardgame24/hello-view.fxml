<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="440.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cardgame24.HelloController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="findSolutionButton" mnemonicParsing="false" onAction="#onFindSolution" text="FInd a solution" />
            <TextField fx:id="solutionField" editable="false" prefWidth="220.0" promptText="Solution" />
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#onRefresh" text="Refresh" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox prefHeight="220.0" prefWidth="600.0" spacing="16.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fx:id="card1Image" fitHeight="200.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="card2Image" fitHeight="200.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="card3Image" fitHeight="200.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="card4Image" fitHeight="200.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </HBox>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Enter an expression:" />
            <TextField fx:id="expressionField" promptText="Enter your expression here" />
            <Button fx:id="verifyButton" mnemonicParsing="false" onAction="#onVerify" text="Verify" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
